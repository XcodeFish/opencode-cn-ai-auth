{
  "name": "opencode-cn-ai-auth",
  "version": "0.7.1",
  "description": "Magpie bundle and direct OpenCode entries for Loomy (讯飞), Raccoon (商汤小浣熊) and TRAE (字节跳动) coding subscriptions",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./opencode/loomy": "./opencode/loomy.ts",
    "./opencode/raccoon": "./opencode/raccoon.ts",
    "./opencode/trae": "./opencode/trae.ts"
  },
  "files": [
    "index.ts",
    "opencode",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "auth",
    "loomy",
    "xfyun",
    "iflytek",
    "raccoon",
    "sensenova",
    "sensetime",
    "trae",
    "bytedance"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0",
    "opencode": ">=2.0.0 <3"
  },
  "scripts": {
    "check": "bun scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
